# Server-only configuration. Never use a service-role or sb_secret key here.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Optional server-only public-job classification. CRUD and screening need no AI key.
# Enable only after adding your real key securely and allowing api.openai.com if restricted.
AI_CLASSIFICATION_ENABLED=false
OPENAI_API_KEY=
OPENAI_CLASSIFICATION_MODEL=gpt-4.1-mini
OPENAI_CLASSIFICATION_TEMPERATURE=0
OPENAI_CLASSIFICATION_RETRIES=1
