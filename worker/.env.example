# Optional for the Phase 1 database probe. Use a direct/session-pooler connection.
# Local connections use the generated ignored .env from npm run db:config.
# Hosted connections MUST include sslmode=verify-full and trusted system CA roots.
DATABASE_URL=
AUTOMATION_ENABLED=false
DAILY_TARGET=30
TIMEZONE=Asia/Karachi

# Phase 6 uses a separate restricted database identity, never DATABASE_URL above.
# Local setup: worker/.venv/bin/python scripts/configure_scheduler.py (from repo root).
# Hosted: an operator grants only the remote_jobs_scheduler role to a dedicated login.
# Hosted TLS requires sslmode=verify-full&sslrootcert=system here too.
SCHEDULER_DATABASE_URL=
SCHEDULER_ENABLED=false
SCHEDULER_CONCURRENCY=2
SCHEDULER_POLL_SECONDS=30
